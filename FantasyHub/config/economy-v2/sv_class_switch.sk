# SVFrame class switching layer v28
# Menu -> /svclass switch <class>
# Payment/cooldown commit: Fantasy Hub native transaction. Default 3000 beastcoin; Dragonborn/Death Knight 2 huntercoin.

options:
    prefix: &5Marilyn &8»
    class-switch-fee: 3000
    class-switch-cooldown: 60 minutes

function svclass_name(id: text) :: text:
