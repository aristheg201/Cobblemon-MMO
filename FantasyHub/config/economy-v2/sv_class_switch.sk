function svclass_supporter(p: player) :: boolean:
    if {_p} has permission "svframe.supporter":
        return true
    if {_p} has permission "svframe.donator":
        return true
    if {_p} has permission "argonmc.rank.vip":
        return true
    if {_p} has permission "argonmc.rank.sergeant":
        return true
    if {_p} has permission "argonmc.rank.lieutenant":
        return true
    if {_p} has permission "argonmc.rank.captain":
        return true
    if {_p} has permission "argonmc.rank.mvp":
        return true
    if {_p} has permission "argonmc.rank.viscount":
        return true
    if {_p} has permission "argonmc.rank.earl":
        return true
    if {_p} has permission "argonmc.rank.duke":
        return true
    if {_p} has permission "argonmc.rank.elite":
        return true
    return false

function svclass_skyrim_complete(p: player) :: boolean:
    if {_p} does not have permission "svframe.story.boss.ashensentinel":
        return false
    if {_p} does not have permission "svframe.story.boss.wolfknight":
        return false
    if {_p} does not have permission "svframe.story.boss.draugrlord":
        return false
    if {_p} does not have permission "svframe.story.boss.ustengravlord":
        return false
    if {_p} does not have permission "svframe.story.boss.kingpin":
        return false
    if {_p} does not have permission "svframe.story.boss.dwemersmith":
        return false
    if {_p} does not have permission "svframe.story.boss.firedragon":
        return false
    if {_p} does not have permission "svframe.story.boss.frostdragon":
        return false
    if {_p} does not have permission "svframe.story.boss.undeaddragon":
        return false
    if {_p} does not have permission "svframe.story.boss.voiddragon":
        return false
    if {_p} does not have permission "svframe.story.boss.ancientdragon":
        return false
    if {_p} does not have permission "svframe.story.boss.mirmulnir":
        return false
    if {_p} does not have permission "svframe.story.boss.sahloknir":
        return false
    if {_p} does not have permission "svframe.story.boss.odahviing":
        return false
    if {_p} does not have permission "svframe.story.boss.revenant":
        return false
    if {_p} does not have permission "svframe.story.boss.forestlady":
        return false
    if {_p} does not have permission "svframe.story.boss.hastur":
        return false
    if {_p} does not have permission "svframe.story.boss.fallenangel":
        return false
    if {_p} does not have permission "svframe.story.boss.nahkriin":
        return false
    if {_p} does not have permission "svframe.story.boss.alduin":
        return false
    return true

function svclass_unlocked(p: player, id: text) :: boolean:
    if {_id} is "hunter":
        if {_p} has permission "svframe.class.hunter.override":
            return true
        send "{@prefix} &cHunter chưa mở trong mùa này. Wild Hunt chưa gọi tên, đừng tự ký giấy báo tử." to {_p}
        return false
    if {_id} is "dragonborn":
        if {_p} has permission "svframe.class.dragonborn":
            return true
        if svclass_supporter({_p}) is true:
            return true
        if svclass_skyrim_complete({_p}) is true:
            return true
        send "{@prefix} &cDragonborn chỉ mở cho Supporter hoặc người đã dọn sạch toàn bộ boss Skyrim mùa này." to {_p}
        return false
    set {_perm} to "svframe.class.%{_id}%"
    if {_p} has permission {_perm}:
        return true
    send "{@prefix} &cChưa mở class &e%svclass_name({_id})%&c. Đi đập boss đúng tuyến truyện trước đã, menu không nhận niềm tin làm giấy phép." to {_p}
    return false

function svclass_begin(p: player) :: boolean:
    if {svclass.lock::%uuid of {_p}%} is true:
        send "{@prefix} &cBấm chậm thôi. Class không chạy mất, chỉ có ví của ngươi là dễ bay." to {_p}
        return false
    set {svclass.lock::%uuid of {_p}%} to true
    return true

function svclass_end(p: player):
    delete {svclass.lock::%uuid of {_p}%}

command /classmenu [<text>]:
    trigger:
        execute console command "dm open svframe_class_switch %player%"

command /classes [<text>]:
    trigger:
        execute console command "dm open svframe_class_switch %player%"

command /doiclass [<text>]:
    trigger:
        execute console command "dm open svframe_class_switch %player%"

command /svclass [<text>] [<text>]:
    trigger:
        if arg-1 is not set:
            send "{@prefix} &7Dùng: &e/svclass switch <class>&7. Hoặc mở &e/classmenu&7." to player
            stop
        set {_action} to lowercase arg-1
        if {_action} is not "switch":
            send "{@prefix} &7Dùng: &e/svclass switch <class>&7. Hoặc mở &e/classmenu&7." to player
            stop
        if arg-2 is not set:
            send "{@prefix} &cThiếu class id. Menu có nút, dùng nút đi cho đỡ lạc." to player
            stop
        set {_class} to lowercase arg-2
        replace all " " with "_" in {_class}
        if svclass_valid({_class}) is false:
            send "{@prefix} &cClass &e%{_class}% &ckhông nằm trong danh sách mùa này." to player
            stop
        execute console command "fantasyhub classpurchase %player% %{_class}%"
