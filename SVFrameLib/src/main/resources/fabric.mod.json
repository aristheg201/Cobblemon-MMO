{
  "schemaVersion": 1,
  "id": "svframelib",
  "version": "${version}",
  "name": "SVFrameLib",
  "description": "Native Fabric 1.21.1 port of MythicLib 1.7.1.",
  "environment": "server",
  "entrypoints": {
    "main": [
      "vn.svframe.mythiclibfabric.SVFrameLibBootstrap",
      "vn.svframe.mythiclibfabric.MythicLibFabricMod",
      "vn.svframe.mythiclibfabric.MythicLibStatMod",
      "vn.svframe.mythiclibfabric.MythicLibCombatMod",
      "vn.svframe.mythiclibfabric.MythicLibPassiveMod",
      "vn.svframe.mythiclibfabric.MythicLibArmorPassiveMod",
      "vn.svframe.mythiclibfabric.MythicLibPlayerDataMod",
      "vn.svframe.mythiclibfabric.MythicLibCraftingBootstrap"
    ]
  },
  "mixins": ["mythiclibfabric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
